# Public identifiers used by the Astro site to read published Sanity content.
# These are not secrets. Find them at https://sanity.io/manage.
PUBLIC_SANITY_PROJECT_ID=cubrqt5i
PUBLIC_SANITY_DATASET=production

# Existing consultation form endpoint. Keep the real value in .env.local.
PUBLIC_FORM_ENDPOINT=

# Destination for temporary homepage session requests. Resend credentials and
# sender domain are provisioned automatically by the Vercel integration.
SESSION_REQUEST_TO_EMAIL=
