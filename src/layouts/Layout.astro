---
import 'lenis/dist/lenis.css'
import Analytics from '@vercel/analytics/astro'
import '../styles.css'
import '../home-concept.css'

interface Props {
  title: string
  description?: string
  robots?: string
  lang?: 'en' | 'ko'
  alternateEnglish?: string
  alternateKorean?: string
}

const {
  title,
  description = 'Individual therapy with Eunice Lee, LCSW, online and in person in Basking Ridge, NJ. Licensed in New York and New Jersey. Support in English and Korean.',
  robots = 'index, follow',
  lang = 'en',
  alternateEnglish,
  alternateKorean,
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#edeae4" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {alternateEnglish && <link rel="alternate" hreflang="en" href={alternateEnglish} />}
    {alternateKorean && <link rel="alternate" hreflang="ko" href={alternateKorean} />}
    {alternateEnglish && <link rel="alternate" hreflang="x-default" href={alternateEnglish} />}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
