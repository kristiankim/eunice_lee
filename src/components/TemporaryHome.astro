---
import logoUrl from '../../assets/Journey2grow_Logo 3.svg?url'
---

<main class="temporary-home">
  <header class="temporary-header">
    <img
      class="temporary-logo"
      src={logoUrl}
      alt="Journey 2 Grow Therapy"
      width="548"
      height="269"
    />
  </header>

  <section class="temporary-intro" aria-labelledby="session-request-title">
    <div class="temporary-copy">
      <p class="status"><span aria-hidden="true"></span> Website coming soon</p>

      <figure class="portrait">
        <img
          src="/images/eunice-lee.png"
          alt="Eunice Lee, licensed clinical social worker"
          width="320"
          height="400"
        />
        <figcaption>Eunice Lee, LCSW</figcaption>
      </figure>

      <p class="introduction">
        I’m Eunice Lee, a Licensed Clinical Social Worker offering individual therapy for anxiety,
        relationships, life transitions, and the questions that can be difficult to carry alone.
      </p>

      <dl class="practice-details">
        <div>
          <dt>Sessions</dt>
          <dd>Online and in person in Basking Ridge, NJ</dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>English and Korean</dd>
        </div>
      </dl>
    </div>

    <div class="request-panel">
      <div class="form-heading">
        <p>Free 15-minute consultation</p>
        <h1 id="session-request-title">Request a session</h1>
        <p>Share a few details below and Eunice will follow up about availability and next steps.</p>
      </div>

      <form id="session-request-form" autocomplete="on">
        <div class="field-row">
          <label>
            <span>Name <b aria-hidden="true">*</b></span>
            <input name="name" type="text" autocomplete="name" maxlength="100" required />
          </label>
          <label>
            <span>Email <b aria-hidden="true">*</b></span>
            <input name="email" type="email" autocomplete="email" maxlength="200" required />
          </label>
        </div>

        <label>
          <span>Phone <small>Optional</small></span>
          <input name="phone" type="tel" autocomplete="tel" maxlength="30" />
        </label>

        <label>
          <span>Session preference <b aria-hidden="true">*</b></span>
          <select name="sessionPreference" required>
            <option value="">Select an option</option>
            <option value="Online">Online</option>
            <option value="In person in Basking Ridge">In person in Basking Ridge</option>
            <option value="Not sure yet">Not sure yet</option>
          </select>
        </label>

        <fieldset class="support-reasons">
          <legend>
            <span>Main reason for seeking support</span>
            <small>Select all that apply</small>
          </legend>
          <div class="support-options">
            <label><input type="checkbox" name="supportReasons" value="Anxiety" /> <span>Anxiety</span></label>
            <label><input type="checkbox" name="supportReasons" value="Depression" /> <span>Depression</span></label>
            <label><input type="checkbox" name="supportReasons" value="Relationships" /> <span>Relationships</span></label>
            <label><input type="checkbox" name="supportReasons" value="Life transitions" /> <span>Life transitions</span></label>
            <label><input type="checkbox" name="supportReasons" value="Immigration &amp; adjustment" /> <span>Immigration &amp; adjustment</span></label>
            <label><input type="checkbox" name="supportReasons" value="Self-esteem" /> <span>Self-esteem</span></label>
            <label><input type="checkbox" name="supportReasons" value="Anger management" /> <span>Anger management</span></label>
            <label><input type="checkbox" name="supportReasons" value="Faith-based" /> <span>Faith-based</span></label>
            <label><input type="checkbox" name="supportReasons" value="Trauma" /> <span>Trauma</span></label>
            <label><input type="checkbox" name="supportReasons" value="Career development" /> <span>Career development</span></label>
            <label><input type="checkbox" name="supportReasons" value="Other" /> <span>Other</span></label>
          </div>
        </fieldset>

        <label>
          <span>What would you like support with?</span>
          <textarea
            name="message"
            rows="4"
            maxlength="2000"
            placeholder="A brief note is enough."
          ></textarea>
          <small class="field-note">Please avoid urgent, crisis, or highly sensitive medical details.</small>
        </label>

        <label class="consent">
          <input name="consent" type="checkbox" value="yes" required />
          <span>I understand this form is for consultation requests and is not monitored for emergencies.</span>
        </label>

        <label class="website-field" aria-hidden="true">
          Website
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>

        <div class="form-submit">
          <button type="submit">Send request <span aria-hidden="true">→</span></button>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </div>
      </form>

      <p class="crisis-note">For immediate support, call or text <a href="tel:988">988</a>. Call 911 if there is immediate danger.</p>
    </div>
  </section>

  <footer class="temporary-footer">
    <p>Journey 2 Grow Therapy</p>
    <p>Licensed in New York &amp; New Jersey</p>
  </footer>
</main>

<script>
  const form = document.querySelector('#session-request-form')
  const status = document.querySelector('#form-status')

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!form.reportValidity()) return

      const button = form.querySelector('button[type="submit"]')
      const formData = new FormData(form)
      const requestId = form.dataset.requestId
        || globalThis.crypto?.randomUUID?.()
        || `${Date.now()}-${Math.random().toString(16).slice(2)}`

      form.dataset.requestId = requestId
      status.className = 'form-status'
      status.textContent = 'Sending…'
      if (button instanceof HTMLButtonElement) button.disabled = true

      try {
        const response = await fetch('/api/request-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: formData.get('name'),
            email: formData.get('email'),
            phone: formData.get('phone'),
            sessionPreference: formData.get('sessionPreference'),
            supportReasons: formData.getAll('supportReasons'),
            message: formData.get('message'),
            consent: formData.get('consent') === 'yes',
            website: formData.get('website'),
            requestId,
          }),
        })

        if (!response.ok) throw new Error('Request could not be sent')

        form.reset()
        delete form.dataset.requestId
        status.className = 'form-status is-success'
        status.textContent = 'Thank you. Your request has been sent.'
      } catch {
        status.className = 'form-status is-error'
        status.textContent = 'Your request couldn’t be sent. Please try again.'
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false
      }
    })
  }
</script>

<style>
  @import url('https://db.onlinewebfonts.com/c/9d4d074c9335825a23cce178ee03b498?family=P22+Mackinac+W01+Book');

  :global(*) { box-sizing: border-box; }

  :global(html) {
    min-width: 320px;
    background: #edeae4;
  }

  :global(body) {
    min-width: 320px;
    margin: 0;
    background: #edeae4;
    color: #1a1f14;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    text-rendering: optimizeLegibility;
  }

  :global(button),
  :global(input),
  :global(select),
  :global(textarea) { font: inherit; }

  .temporary-home {
    width: min(100% - 48px, 1240px);
    min-height: 100svh;
    margin-inline: auto;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .temporary-header,
  .temporary-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .temporary-header {
    min-height: 112px;
    padding-block: 24px;
  }

  .temporary-logo {
    width: auto;
    height: 62px;
  }

  .temporary-intro {
    display: grid;
    grid-template-columns: minmax(300px, 0.82fr) minmax(440px, 1.18fr);
    gap: clamp(56px, 8vw, 112px);
    align-items: start;
    padding-block: clamp(56px, 7vw, 92px);
  }

  .temporary-copy { max-width: 430px; }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    color: #586b45;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.15px;
  }

  .status span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #586b45;
    box-shadow: 0 0 0 5px rgba(88, 107, 69, 0.12);
  }

  .portrait {
    width: min(100%, 360px);
    margin: 0 0 32px;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.78) sepia(0.04);
  }

  .portrait figcaption {
    margin-top: 10px;
    color: #5c6653;
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: -0.15px;
  }

  .introduction {
    margin: 0;
    color: #3f4939;
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .practice-details {
    margin: 32px 0 0;
    border-top: 1px solid rgba(26, 31, 20, 0.14);
  }

  .practice-details div {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid rgba(26, 31, 20, 0.14);
  }

  .practice-details dt,
  .practice-details dd {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    letter-spacing: -0.15px;
  }

  .practice-details dt { color: #7b8274; }
  .practice-details dd { color: #35402f; }

  .request-panel {
    padding: clamp(28px, 4vw, 48px);
    background: #f6f3ed;
    border: 1px solid rgba(26, 31, 20, 0.12);
  }

  .form-heading { margin-bottom: 32px; }

  .form-heading > p:first-child {
    margin: 0 0 12px;
    color: #586b45;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.15px;
  }

  h1 {
    margin: 0 0 14px;
    font-family: 'P22 Mackinac W01 Book', Georgia, serif;
    font-size: clamp(38px, 4.2vw, 56px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .form-heading > p:last-child {
    max-width: 560px;
    margin: 0;
    color: #5c6653;
    font-size: 14px;
    line-height: 1.6;
  }

  form { display: grid; gap: 20px; }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  form > label,
  .field-row label {
    display: grid;
    gap: 8px;
  }

  label > span {
    color: #35402f;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.15px;
  }

  label b { color: #586b45; }

  label small {
    color: #7b8274;
    font-size: 12px;
    font-weight: 400;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid rgba(26, 31, 20, 0.2);
    border-radius: 2px;
    background: #fff;
    color: #1a1f14;
    font-size: 14px;
    line-height: 1.4;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  input,
  select { min-height: 46px; padding: 0 13px; }
  textarea { min-height: 108px; padding: 12px 13px; resize: vertical; }
  textarea::placeholder { color: #91968c; }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: #586b45;
    box-shadow: 0 0 0 3px rgba(88, 107, 69, 0.15);
  }

  .field-note { margin-top: -2px; line-height: 1.45; }

  .support-reasons {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .support-reasons legend {
    width: 100%;
    margin: 0 0 10px;
    padding: 0;
    color: #35402f;
  }

  .support-reasons legend span {
    display: block;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.15px;
  }

  .support-reasons legend small {
    display: block;
    margin-top: 3px;
    color: #7b8274;
    font-size: 12px;
    line-height: 1.4;
  }

  .support-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 20px;
    padding: 16px 18px;
    background: #edeae4;
  }

  .support-options label {
    display: flex;
    min-width: 0;
    min-height: 32px;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }

  .support-options input {
    flex: 0 0 18px;
    width: 18px;
    min-height: 18px;
    height: 18px;
    margin: 0;
    padding: 0;
    accent-color: #586b45;
  }

  .support-options label > span {
    min-width: 0;
    color: #4a5544;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
  }

  .consent {
    grid-template-columns: 18px 1fr;
    align-items: start;
    gap: 10px;
  }

  .consent input {
    width: 18px;
    min-height: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: #586b45;
  }

  .consent span {
    color: #5c6653;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
  }

  .website-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-submit {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px;
  }

  button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 0 20px;
    border: 0;
    border-radius: 2px;
    background: #586b45;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 160ms ease, transform 160ms ease;
  }

  button:hover { background: #344029; transform: translateY(-1px); }
  button:focus-visible { outline: 3px solid #1a1f14; outline-offset: 3px; }
  button:disabled { cursor: wait; opacity: 0.65; transform: none; }

  .form-status {
    margin: 0;
    color: #5c6653;
    font-size: 12px;
    line-height: 1.45;
  }

  .form-status.is-success { color: #43603d; }
  .form-status.is-error { color: #9b3f30; }

  .crisis-note {
    margin: 28px 0 0;
    padding-top: 18px;
    border-top: 1px solid rgba(26, 31, 20, 0.12);
    color: #737b6d;
    font-size: 12px;
    line-height: 1.55;
  }

  .crisis-note a { color: #35402f; font-weight: 500; }

  .temporary-footer {
    min-height: 76px;
    padding-block: 20px;
    border-top: 1px solid rgba(26, 31, 20, 0.14);
  }

  .temporary-footer p {
    margin: 0;
    color: #5c6653;
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: -0.15px;
  }

  @media (max-width: 900px) {
    .temporary-intro {
      grid-template-columns: minmax(260px, 0.75fr) minmax(400px, 1.25fr);
      gap: 40px;
    }
  }

  @media (max-width: 760px) {
    .temporary-home { width: min(100% - 32px, 560px); }
    .temporary-header { min-height: 92px; }
    .temporary-logo { width: auto; height: 54px; }

    .temporary-intro {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-block: 48px 64px;
    }

    .temporary-copy,
    .portrait { max-width: none; width: 100%; }

    .request-panel { padding: 28px 22px; }
    .field-row { grid-template-columns: 1fr; gap: 20px; }
    .support-options { grid-template-columns: 1fr; }
    .form-submit { grid-template-columns: 1fr; }
    button { width: 100%; }

    .temporary-footer {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .temporary-copy > *,
    .request-panel {
      animation: enter 650ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .temporary-copy > :nth-child(2) { animation-delay: 60ms; }
    .temporary-copy > :nth-child(3) { animation-delay: 120ms; }
    .temporary-copy > :nth-child(4) { animation-delay: 180ms; }
    .request-panel { animation-delay: 100ms; }
  }

  @keyframes enter {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
